# Copy to deploy/thor/.env on the Thor. Do not commit the real file.
APP_IMAGE=localhost/det-dashboard:thor
APP_PORT=5173
APP_BIND_ADDRESS=0.0.0.0
LOCAL_UID=1000
LOCAL_GID=1000

POSTGRES_DB=det_dashboard
POSTGRES_USER=det
POSTGRES_PASSWORD=change-this-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-password
MINIO_BUCKET=zbh-datasets

POSTGRES_DATA_DIR=/home/cngc209/det-dashboard-data/postgres
MINIO_DATA_DIR=/home/cngc209/det-dashboard-data/minio
APP_STORAGE_DIR=/home/cngc209/det-dashboard-data/storage
EXPORTS_DIR=/home/cngc209/det-dashboard-data/exports
DATASETS_DIR=/home/cngc209/Datasets
HOST_BROWSE_ROOT=/home/cngc209/Datasets
HOST_DATASETS_ROOT=/home/cngc209/Datasets
HOST_MODELS_ROOT=/home/cngc209/Models
DATA_ROOT_DISPLAY=/home/cngc209/Datasets
BROWSE_ROOT_DISPLAY=/home/cngc209/Datasets
EXPORT_ROOT_DISPLAY=/home/cngc209/det-dashboard-data/exports
HOST_STORAGE_ROOT=/home/cngc209/det-dashboard-data/storage

INFERENCE_SIDECAR_URL=http://host.containers.internal:4178
DINO_SIDECAR_URL=http://host.containers.internal:4181
DB_POOL_MAX=20
