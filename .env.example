# Copy this file to .env for local development.
# Keep this example generic; put machine-specific paths in .env.

PORT=4177

# Dataset source root. The app only imports files from paths under this root.
DATA_ROOT=./runtime/data-root
DATA_ROOT_DISPLAY=./runtime/data-root
BROWSE_ROOT=./runtime/data-root
BROWSE_ROOT_DISPLAY=./runtime/data-root
HOST_PATH_MODE=posix

# Local cache root for runtime files, exports, object-store fallback, model copies,
# and unpacked Python environments. MinIO remains the source of truth for assets.
STORAGE_ROOT=./runtime/cache

# PostgreSQL connection used by the Node API.
DATABASE_URL=postgres://det:det_password@localhost:15432/det_dashboard

# MinIO object storage used as the formal asset store.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zbh-datasets

# Optional host-side GPU inference receiver. The callback URL must be reachable
# from the Python sidecar, not merely from the browser.
# INFERENCE_SIDECAR_URL=http://host.containers.internal:4178
# INFERENCE_CALLBACK_URL=http://host.containers.internal:5173/api/ml/inference-receiver/events
# INFERENCE_CALLBACK_TOKEN=replace-with-a-long-random-secret

# Docker container names used by restart scripts.
POSTGRES_CONTAINER=det-dashboard-postgres
MINIO_CONTAINER=det-dashboard-minio
POSTGRES_PORT=15432

# Docker data directories. Docker Compose reads these from .env.
POSTGRES_DATA_DIR=./runtime/postgres
MINIO_DATA_DIR=./runtime/minio

# Windows example:
# HOST_PATH_MODE=windows
# DATA_ROOT=F:\ZBH
# DATA_ROOT_DISPLAY=F:\ZBH
# BROWSE_ROOT=F:\ZBH
# BROWSE_ROOT_DISPLAY=F:\ZBH
# STORAGE_ROOT=F:\ZBH\zhuji\runtime\cache
# POSTGRES_PORT=15432
# POSTGRES_DATA_DIR=./runtime/postgres
# MINIO_DATA_DIR=./runtime/minio
